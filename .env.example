# Flask session signing key. Set this to a long, random value in every deployed environment.
FLASK_SECRET_KEY=replace-with-a-long-random-secret

# OpenAI API configuration.
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin

# Optional feedback generation model.
FEEDBACK_MODEL=gpt-4o-mini

# Optional PIN protection. Leave unset to disable authentication.
# APP_PIN=replace-with-a-pin

# Optional local data and scenario locations.
SQLITE_PATH=app.db
SCENARIOS_PATH=scenarios.json

# Legacy Socket.IO/WebSocket path. Keep disabled for the recommended WebRTC flow.
ENABLE_LEGACY_OPENAI_WS=0